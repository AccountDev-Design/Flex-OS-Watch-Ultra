# Flex OS Watch Ultra — Waveshare ESP32-S3-Touch-AMOLED-2.06
# ESP32-S3R8 (PSRAM octal de 8 MB en el encapsulado) + flash GD25Q256 (32 MB).
# Base: ejemplo oficial 02_lvgl_demo_v9 (waveshareteam/ESP32-S3-Touch-AMOLED-2.06
# @ b099739), salvo lo indicado.
CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------------------
# Flash: 32 MB físicos (docs/FLASH-32MB.md).
# DIFERENCIA con el oficial (que declara 16 MB): se declaran los 32 MB reales
# para poder ubicar datos por encima de 16 MB. El código sigue por debajo de
# 16 MB y NO se activa CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH
# (experimental en ESP-IDF 5.5.5).
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# CPU y PSRAM (como el ejemplo oficial; XIP_FROM_PSRAM es el nombre en 5.5.5
# de SPIRAM_FETCH_INSTRUCTIONS + SPIRAM_RODATA)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Volcado de memoria a la partición "coredump" para diagnosticar fallos
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---------------------------------------------------------------------------
# LVGL 9.5.0
# ---------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
# DIFERENCIA con el oficial: sin LVGL en IRAM. Medido en la compilación de B1:
# con la opción, la RAM interna estática usada sube de 86 KB a 194 KB (deja
# 148 KB en vez de 255 KB). Esa RAM la necesitan los buffers DMA de pantalla
# y, en fases siguientes, Wi-Fi/BLE/TLS. Se revisará con los FPS medidos.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_GRADIENT_MAX_STOPS=4
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
# Medidor de FPS/CPU en pantalla: retirado (era solo para medir en B1 y
# ocupaba una franja negra abajo). watch_display lo oculta además en tiempo de
# ejecución por si un sdkconfig antiguo lo sigue activando.
# CONFIG_LV_USE_SYSMON is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
# Vistas previas del selector de esferas (lv_snapshot). También se fuerza en
# CMakeLists.txt para los sdkconfig ya generados.
CONFIG_LV_USE_SNAPSHOT=y
# Rótulo curvo de la esfera Ultra (lv_arclabel). También en CMakeLists.txt.
CONFIG_LV_USE_ARCLABEL=y
CONFIG_LV_BUILD_EXAMPLES=n

# ---------------------------------------------------------------------------
# LittleFS (F4.6, partición "storage" de 16 MB por encima de 16 MB)
# ---------------------------------------------------------------------------
# Sin mapear la partición en caché: la caché solo direcciona 24 bits y por
# encima de 16 MB leería datos de la zona baja (docs/FLASH-32MB.md).
# CONFIG_LITTLEFS_MMAP_PARTITION is not set
# 512 B de "lookahead" cubren los 4096 bloques de 4 KB en una sola pasada.
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=512
# Búferes de E/S de flash en RAM interna (no en PSRAM).
CONFIG_LITTLEFS_MALLOC_STRATEGY_INTERNAL=y

# ---------------------------------------------------------------------------
# Wi-Fi (F5.1): búferes de Wi-Fi y lwIP en PSRAM cuando se pueda. La RAM
# interna la necesitan los búferes DMA de la pantalla y, después, el BLE.
# ---------------------------------------------------------------------------
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# HTTPS (Clima F9.8; después OTA): mbedTLS reserva en PSRAM (un saludo TLS
# pide unos 40 KB) y verifica con el paquete de CA de ESP-IDF.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# OTA (F7): reversión automática. La imagen nueva arranca "pendiente" y
# watch_ota la confirma a los 60 s; un reinicio antes vuelve a la anterior.
# Va en el cargador de arranque: hay que grabarlo una vez por USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Navegador (F6): JPEG baseline con el TJpgDec de LVGL (el S3 no tiene
# decodificador JPEG por hardware).
CONFIG_LV_USE_TJPGD=y

# ---------------------------------------------------------------------------
# Bluetooth LE (F5.5): NimBLE como CENTRAL hacia el GattServer de la app Flex
# Phone (el teléfono anuncia y sirve; el reloj busca y conecta). Pila de host
# en PSRAM; vínculos BLE en NVS. MTU 247 obligatorio (tramas de 244 B).
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# El rol de periférico no se usa para anunciar (BROADCASTER apagado): hace
# falta para el servidor GATT con el servicio GAP, que es de donde Android
# lee el nombre "Flex OS Watch" que enseña al pedir el emparejamiento.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Flex OS Watch"
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
